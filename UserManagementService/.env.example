# JWT Secret Key - MUST be a strong random string
# This MUST match across all services for authentication to work
JWT_SECRET=your_jwt_secret_key_here

# MongoDB Connection
MONGODB_URL=mongodb://localhost:27017/userManagement

# Express Session Secret
SESSION_SECRET=your_session_secret_here

# Google OAuth Credentials
CLIENT_ID=your_google_client_id_here
CLIENT_SECRET=your_google_client_secret_here

# Frontend URLs for OAuth redirects
CLIENT_URL=http://localhost:3000/google-login
CLIENT_URL_FAIL=http://localhost:3000/login

# Service Port
PORT=3001

# Node Environment
NODE_ENV=development
